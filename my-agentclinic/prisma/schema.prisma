generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id          String       @id @default(cuid())
  name        String
  specialty   String?
  createdAt   DateTime     @default(now())
  appointments Appointment[]
}

model Ailment {
  id        String @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model Therapy {
  id        String @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model Appointment {
  id         String   @id @default(cuid())
  agent      Agent    @relation(fields: [agentId], references: [id])
  agentId    String
  patient    String
  scheduled  DateTime
  notes      String?
  createdAt  DateTime @default(now())
}
